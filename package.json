  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.tsx",
    "start": "bun run src/index.tsx",
    "build:css": "tailwindcss -i src/styles/input.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/app.css --watch",
