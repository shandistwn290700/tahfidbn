    "quran-json": "^3.1.2",
    "sweetalert2": "^11.14.5",
    "tailwindcss": "^3.4.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.11.10",
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1",
    "pdfkit": "^0.15.1"
  }
}
