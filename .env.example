APP_NAME=Tahfiz Community
APP_URL=http://localhost:3000
PORT=3000

# Akun administrator pertama. Dibuat otomatis saat aplikasi dijalankan
# pertama kali, selama belum ada pengguna sama sekali di basis data.
# Ganti passwordnya lewat menu Akun setelah berhasil masuk.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Integrasi Canva (Connect API) — wajib untuk Laporan Pekanan. Dibuat lewat
# canva.com/developers/apps, bagian "Outside Canva" > "Canva REST APIs".
# Panduan lengkap: docs/CANVA-SETUP.md
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Redirect URI harus persis sama dengan yang didaftarkan di dashboard Canva.
# - Komputer lokal: pakai 127.0.0.1 (Canva menolak "localhost"), seperti di bawah.
# - Server/VPS: HAPUS baris ini — otomatis memakai APP_URL + /administrasi/pengaturan/canva/callback,
#   mis. https://tahfid.sekolah.sch.id/administrasi/pengaturan/canva/callback
CANVA_REDIRECT_URI=http://127.0.0.1:3000/administrasi/pengaturan/canva/callback
