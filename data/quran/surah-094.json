{"surahNumber":94,"ayahs":[{"number":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","latin":"Alam nasyraḥ laka ṣadrak(a).","translation":"Bukankah kami telah melapangkan dadamu (Muhammad)?"},{"number":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","latin":"Wa waḍa‘nā ‘anka wizrak(a).","translation":"dan kami pun telah menurunkan beban darimu,"},{"number":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","latin":"Allażī anqaḍa ẓahrak(a).","translation":"yang memberatkan punggungmu,"},{"number":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","latin":"Wa rafa‘nā laka żikrak(a).","translation":"dan kami tinggikan sebutan (nama)mu bagimu."},{"number":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","latin":"Fa'inna ma‘al-‘usri yusrā(n).","translation":"Maka sesungguhnya bersama kesulitan ada kemudahan,"},{"number":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","latin":"Inna ma‘al-‘usri yusrā(n).","translation":"sesungguhnya bersama kesulitan ada kemudahan."},{"number":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","latin":"Fa iżā faragta fanṣab.","translation":"Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain),"},{"number":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","latin":"Wa ilā rabbika fargab.","translation":"dan hanya kepada Tuhanmulah engkau berharap."}]}