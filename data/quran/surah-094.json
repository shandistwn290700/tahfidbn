{"surahNumber":94,"ayahs":[{"number":1,"text":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","latin":"Alam nasyraḥ laka ṣadrak(a).","translation":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),"},{"number":2,"text":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","latin":"Wa waḍa‘nā ‘anka wizrak(a).","translation":"meringankan beban (tugas-tugas kenabian) darimu"},{"number":3,"text":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","latin":"Allażī anqaḍa ẓahrak(a).","translation":"yang memberatkan punggungmu,"},{"number":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","latin":"Wa rafa‘nā laka żikrak(a).","translation":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?"},{"number":5,"text":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","latin":"Fa'inna ma‘al-‘usri yusrā(n).","translation":"Maka, sesungguhnya beserta kesulitan ada kemudahan."},{"number":6,"text":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","latin":"Inna ma‘al-‘usri yusrā(n).","translation":"Sesungguhnya beserta kesulitan ada kemudahan."},{"number":7,"text":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","latin":"Fa iżā faragta fanṣab.","translation":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)"},{"number":8,"text":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","latin":"Wa ilā rabbika fargab.","translation":"dan hanya kepada Tuhanmu berharaplah!"}]}