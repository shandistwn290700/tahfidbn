{"surahNumber":114,"ayahs":[{"number":1,"text":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","latin":"Qul a‘ūżu birabbin-nās(i).","translation":"Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,"},{"number":2,"text":"مَلِكِ النَّاسِۙ","latin":"Malikin-nās(i).","translation":"raja manusia,"},{"number":3,"text":"اِلٰهِ النَّاسِۙ","latin":"Ilāhin-nās(i).","translation":"sembahan manusia"},{"number":4,"text":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","latin":"Min syarril-waswāsil-khannās(i).","translation":"dari kejahatan (setan) pembisik yang bersembunyi"},{"number":5,"text":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","latin":"Allażī yuwaswisu fī ṣudūrin-nās(i).","translation":"yang membisikkan (kejahatan) ke dalam dada manusia,"},{"number":6,"text":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ","latin":"Minal jinnati wan-nās(i).","translation":"dari (golongan) jin dan manusia.”"}]}