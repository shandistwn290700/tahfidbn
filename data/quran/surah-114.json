{"surahNumber":114,"ayahs":[{"number":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","latin":"Qul a‘ūżu birabbin-nās(i).","translation":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,"},{"number":2,"text":"مَلِكِ ٱلنَّاسِ","latin":"Malikin-nās(i).","translation":"Raja manusia,"},{"number":3,"text":"إِلَٰهِ ٱلنَّاسِ","latin":"Ilāhin-nās(i).","translation":"sembahan manusia,"},{"number":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","latin":"Min syarril-waswāsil-khannās(i).","translation":"dari kejahatan (bisikan) setan yang bersembunyi,"},{"number":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","latin":"Allażī yuwaswisu fī ṣudūrin-nās(i).","translation":"yang membisikkan (kejahatan) ke dalam dada manusia,"},{"number":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","latin":"Minal jinnati wan-nās(i).","translation":"dari (golongan) jin dan manusia.\""}]}