{"surahNumber":101,"ayahs":[{"number":1,"text":"ٱلۡقَارِعَةُ","latin":"Al-qāri‘ah(tu).","translation":"Hari Kiamat,"},{"number":2,"text":"مَا ٱلۡقَارِعَةُ","latin":"Mal-qāri‘ah(tu).","translation":"Apakah hari Kiamat itu?"},{"number":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","latin":"Wa mā adrāka mal-qāri‘ah(tu).","translation":"Dan tahukah kamu apakah hari Kiamat itu?"},{"number":4,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","latin":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","translation":"Pada hari itu manusia seperti laron yang beterbangan,"},{"number":5,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","latin":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","translation":"dan gunung-gunung seperti bulu yang dihambur-hamburkan."},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","latin":"Fa ammā man ṡaqulat mawāzīnuh(ū).","translation":"Maka adapun orang yang berat timbangan (kebaikan)nya,"},{"number":7,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","latin":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","translation":"maka dia berada dalam kehidupan yang memuaskan (senang)."},{"number":8,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","latin":"Wa ammā man khaffat mawāzīnuh(ū).","translation":"Dan adapun orang yang ringan timbangan (kebaikan)nya,"},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٞ","latin":"Fa ummuhū hāwiyah(tun).","translation":"maka tempat kembalinya adalah neraka Hāwiyah."},{"number":10,"text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","latin":"Wa mā adrāka mā hiyah.","translation":"Dan tahukah kamu apakah neraka Hāwiyah itu?"},{"number":11,"text":"نَارٌ حَامِيَةُۢ","latin":"Nārun ḥāmiyah(tun).","translation":"(Yaitu) api yang sangat panas."}]}