{"surahNumber":101,"ayahs":[{"number":1,"text":"اَلْقَارِعَةُۙ","latin":"Al-qāri‘ah(tu).","translation":"Al-Qāri‘ah (hari Kiamat yang menggetarkan)."},{"number":2,"text":"مَا الْقَارِعَةُ ۚ","latin":"Mal-qāri‘ah(tu).","translation":"Apakah al-Qāri‘ah itu?"},{"number":3,"text":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","latin":"Wa mā adrāka mal-qāri‘ah(tu).","translation":"Tahukah kamu apakah al-Qāri‘ah itu?"},{"number":4,"text":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","latin":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","translation":"Pada hari itu manusia seperti laron yang beterbangan"},{"number":5,"text":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","latin":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","translation":"dan gunung-gunung seperti bulu yang berhamburan."},{"number":6,"text":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ","latin":"Fa ammā man ṡaqulat mawāzīnuh(ū).","translation":"Siapa yang berat timbangan (kebaikan)-nya,"},{"number":7,"text":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","latin":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","translation":"dia berada dalam kehidupan yang menyenangkan."},{"number":8,"text":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","latin":"Wa ammā man khaffat mawāzīnuh(ū).","translation":"Adapun orang yang ringan timbangan (kebaikan)-nya,"},{"number":9,"text":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","latin":"Fa ummuhū hāwiyah(tun).","translation":"tempat kembalinya adalah (neraka) Hawiyah."},{"number":10,"text":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","latin":"Wa mā adrāka mā hiyah.","translation":"Tahukah kamu apakah (neraka Hawiyah) itu?"},{"number":11,"text":"نَارٌ حَامِيَةٌ ࣖ","latin":"Nārun ḥāmiyah(tun).","translation":"(Ia adalah) api yang sangat panas."}]}