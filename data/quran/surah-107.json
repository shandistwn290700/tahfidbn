{"surahNumber":107,"ayahs":[{"number":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","latin":"Ara'aital-lażī yukażżibu bid-dīn(i).","translation":"Tahukah kamu (orang) yang mendustakan agama?"},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","latin":"Fa żālikal-lażī yadu‘‘ul-yatīm(a).","translation":"Maka itulah orang yang menghardik anak yatim,"},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","latin":"Wa lā yaḥuḍḍu ‘alā ṭa‘āmil-miskīn(i).","translation":"dan tidak mengajak memberi makan orang miskin."},{"number":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","latin":"Fawailul lil-muṣallīn(a).","translation":"Maka celakalah orang yang salat,"},{"number":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","latin":"Allażīna hum ‘an ṣalātihim sāhūn(a).","translation":"(yaitu) orang-orang yang lalai terhadap salatnya,"},{"number":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","latin":"Allażīna hum yurā'ūn(a).","translation":"yang berbuat riya`,"},{"number":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","latin":"Wa yamna‘ūnal-mā‘ūn(a).","translation":"dan enggan (memberikan) bantuan."}]}