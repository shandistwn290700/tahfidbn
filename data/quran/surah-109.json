{"surahNumber":109,"ayahs":[{"number":1,"text":"قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَۙ","latin":"Qul yā ayyuhal-kāfirūn(a).","translation":"Katakanlah (Nabi Muhammad), “Wahai orang-orang kafir,"},{"number":2,"text":"لَآ اَعْبُدُ مَا تَعْبُدُوْنَۙ","latin":"Lā a‘budu mā ta‘budūn(a).","translation":"aku tidak akan menyembah apa yang kamu sembah."},{"number":3,"text":"وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۚ","latin":"Wa lā antum ‘ābidūna mā a‘bud(u).","translation":"Kamu juga bukan penyembah apa yang aku sembah."},{"number":4,"text":"وَلَآ اَنَا۠ عَابِدٌ مَّا عَبَدْتُّمْۙ","latin":"Wa lā ana ‘ābidum mā ‘abattum.","translation":"Aku juga tidak pernah menjadi penyembah apa yang kamu sembah."},{"number":5,"text":"وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۗ","latin":"Wa lā antum ‘ābidūna mā a‘bud(u).","translation":"Kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah."},{"number":6,"text":"لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ࣖ","latin":"Lakum dīnukum wa liya dīn(i).","translation":"Untukmu agamamu dan untukku agamaku.”"}]}