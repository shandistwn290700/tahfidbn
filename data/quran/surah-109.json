{"surahNumber":109,"ayahs":[{"number":1,"text":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","latin":"Qul yā ayyuhal-kāfirūn(a).","translation":"Katakanlah (Muhammad), \"Wahai orang-orang kafir!"},{"number":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","latin":"Lā a‘budu mā ta‘budūn(a).","translation":"aku tidak akan menyembah apa yang kamu sembah,"},{"number":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","latin":"Wa lā antum ‘ābidūna mā a‘bud(u).","translation":"dan kamu bukan penyembah apa yang aku sembah,"},{"number":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","latin":"Wa lā ana ‘ābidum mā ‘abattum.","translation":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah,"},{"number":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","latin":"Wa lā antum ‘ābidūna mā a‘bud(u).","translation":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah."},{"number":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","latin":"Lakum dīnukum wa liya dīn(i).","translation":"Untukmu agamamu, dan untukku agamaku.\""}]}